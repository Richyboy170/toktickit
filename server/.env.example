# Copy this file to ".env" and fill in your own local values.
# Do NOT commit your real .env file.
DATABASE_URL="postgresql://toktickit:toktickit@localhost:5432/toktickit?schema=public"
# Optional override used by Vitest. If omitted, tests replace the database name
# above with `toktickit_test` so development data is never changed by cleanup.
TEST_DATABASE_URL="postgresql://toktickit:toktickit@localhost:5432/toktickit_test?schema=public"
PORT=3000
# Optional post-migration password for legacy User rows with no credential.
# Set it only for `npm run prisma:initialize-legacy-passwords`; never commit it.
# LAB3_MIGRATION_INITIAL_PASSWORD="LocalOnly-Migration1"
